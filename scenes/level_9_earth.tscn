[node name="InfoGravityIntro" parent="InfoBoards" index="0" instance=ExtResource("17_info")]
position = Vector2(220, 352)
description = "Earth's gravity pulls everything down. With gravity ON the boulders rest on the ground. Flip the Gravity Switch to turn gravity OFF"

[node name="InfoGravityExplain" parent="InfoBoards" index="1" instance=ExtResource("17_info")]
position = Vector2(960, 352)
description = "Without gravity, objects float instead of falling - that is why astronauts and rocks drift in space. You used the floating boulders as steps to climb up and open the gate."

[node name="InfoDayNightIntro" parent="InfoBoards" index="2" instance=ExtResource("17_info")]
position = Vector2(1880, 352)
description = "Earth spins (rotates) on its axis, so day turns to night. As you travel east, night is falling - creatures of the dark roam and the gate ahead is shut. Rest in the shelter to let time pass. When the Sun rises again, daylight opens the path and burns away the night creatures!"

[node name="InfoDayNightExplain" parent="InfoBoards" index="3" instance=ExtResource("17_info")]
position = Vector2(2440, 352)
description = "As Earth rotates, the side facing the Sun has day and the side turned away has night. The Sun seems to rise in the East and set in the West."

[node name="InfoBoss" parent="InfoBoards" index="4" instance=ExtResource("17_info")]
position = Vector2(2500, 352)
description = "The Void Sentinel guards the way home. Answer its questions about Earth to defeat it."

[node name="InfoMoonIntro" parent="InfoBoards" index="5" instance=ExtResource("17_info")]
position = Vector2(1254, 352)
description = "The Moon makes no light of its own - it shines by reflecting sunlight. As the Moon orbits Earth we see different lit shapes called phases. Press E at the telescope, aim to find the Moon, and watch it change. Confirm when the Full Moon is centred!"

[node name="InfoMoonExplain" parent="InfoBoards" index="6" instance=ExtResource("17_info")]
position = Vector2(1630, 352)
description = "A Full Moon happens when the Moon is on the opposite side of Earth from the Sun, so we see its whole lit face. Match the Full Moon to open the gate."

