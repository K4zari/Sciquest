[node name="InfoBoardZoneA" parent="InfoBoards" index="0" instance=ExtResource("16_info")]
position = Vector2(240, 352)
description = "Pull the lever to aim the sun at the solar panel and power the gate. Solar energy is renewable — it never runs out."

[node name="InfoBoardSolarTransform" parent="InfoBoards" index="1" instance=ExtResource("16_info")]
position = Vector2(670, 352)
description = "The panel transformed light energy into electrical energy. Energy was not created — it just changed form."

[node name="InfoBoardWind" parent="InfoBoards" index="2" instance=ExtResource("16_info")]
position = Vector2(883, 352)
description = "Pull the lever to open vents. Wind is moving air — kinetic energy. The turbine converts it to electrical energy."

[node name="InfoBoardConservation" parent="InfoBoards" index="3" instance=ExtResource("16_info")]
position = Vector2(1460, 352)
description = "Conservation of Energy: energy cannot be created or destroyed — only transformed between forms."

[node name="InfoBoardSorting" parent="InfoBoards" index="4" instance=ExtResource("16_info")]
position = Vector2(1820, 352)
description = "Find energy orbs hidden in chests across the level, then bring them here. Press E at a generator and choose the matching energy from your inventory."

[node name="InfoBoardBoss" parent="InfoBoards" index="5" instance=ExtResource("16_info")]
position = Vector2(2580, 352)
description = "Magmatar, the Coal Tycoon, awaits. Defeat him to free the plant."

