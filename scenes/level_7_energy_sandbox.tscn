[node name="InfoBoardZoneA" parent="InfoBoards" index="0" instance=ExtResource("16_info")]
position = Vector2(240, 400)
description = "Aim sunlight at the solar panel to power the gate. Solar energy is renewable — it never runs out."

[node name="InfoBoardSolarTransform" parent="InfoBoards" index="1" instance=ExtResource("16_info")]
position = Vector2(670, 400)
description = "The panel transformed light energy into electrical energy. Energy was not created — it just changed form."

[node name="InfoBoardKinetic" parent="InfoBoards" index="2" instance=ExtResource("16_info")]
position = Vector2(820, 400)
description = "Moving objects have kinetic energy. The raised press head stores potential energy that becomes kinetic when it drops."

[node name="InfoBoardWind" parent="InfoBoards" index="3" instance=ExtResource("16_info")]
position = Vector2(1140, 400)
description = "Pull the lever to open vents. Wind is moving air — kinetic energy. The turbine converts it to electrical energy."

[node name="InfoBoardConservation" parent="InfoBoards" index="4" instance=ExtResource("16_info")]
position = Vector2(1460, 400)
description = "Conservation of Energy: energy cannot be created or destroyed — only transformed between forms."

[node name="InfoBoardSorting" parent="InfoBoards" index="5" instance=ExtResource("16_info")]
position = Vector2(1820, 400)
description = "Walk into an orb to pick it up. Press E at the right generator to insert. Press Q to drop. Wrong orb gets ejected. Coal is non-renewable — beware."

[node name="InfoBoardBoss" parent="InfoBoards" index="6" instance=ExtResource("16_info")]
position = Vector2(2580, 400)
description = "Magmatar, the Coal Tycoon, awaits. Defeat him to free the plant."

