; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sciquest"
run/main_scene="res://scenes/edu_world.tscn"
config/features=PackedStringArray("4.1", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Globals="*res://scripts/globals.gd"
SceneChanger="*res://scenes/scene_changer.tscn"
EventBus="*res://scripts/events.gd"
QuestionBank="*res://scripts/question_bank.gd"
BattleManager="*res://scripts/battle_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
DialogManager="*res://scripts/dialog_manager.gd"
InputDeviceManager="*res://scripts/input_device_manager.gd"
GodotMCP="*res://addons/godot_mcp_bridge.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

